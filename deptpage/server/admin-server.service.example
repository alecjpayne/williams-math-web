# Optional template for a future authenticated mathematics editing server.
# This is not used by GitHub Pages and has not been deployed for this project.
# An administrator must choose the server, account, project path and Node setup.
#
# Example setup on the chosen Linux server, subject to its administrator's policy:
#   loginctl enable-linger              # may require administrator assistance
#   node server/set-password.mjs <username>
#   mkdir -p ~/.config/systemd/user
#   cp server/admin-server.service.example ~/.config/systemd/user/admin-server.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now admin-server.service
#
# Then from your laptop (substitute the account and server chosen above):
#   ssh -L 8043:127.0.0.1:8043 USER@EDITING_SERVER
#   open http://localhost:8043/login
#
# Logs: journalctl --user -u admin-server -f

[Unit]
Description=Math Dept Admin Panel
After=network.target

[Service]
WorkingDirectory=%h/williams-math-web/deptpage
ExecStart=/bin/npm run dev -- --host 127.0.0.1 --port 8043 --strictPort
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
